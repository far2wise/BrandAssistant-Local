  },
  "13": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable",
      "noise_seed": 70707,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable",
      "model": ["3", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["12", 2]
    },
    "_meta": { "title": "Pass 1 — high-noise expert (steps 0-2)" }
  },
  "14": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 70707,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 4,
      "return_with_leftover_noise": "disable",
      "model": ["6", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["13", 0]
