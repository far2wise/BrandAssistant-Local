{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "Qwen_Image_Edit-Q8_0.gguf" },
    "_meta": { "title": "Qwen-Image-EDIT UNet (a different model to the txt2img one)" }
  },
  "2": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": {
      "clip_name": "Qwen2.5-VL-7B-Instruct-UD-Q4_K_S.gguf",
      "type": "qwen_image"
    },
    "_meta": { "title": "Qwen2.5-VL — auto-pairs the mmproj vision projector" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Qwen-Image VAE" }
  },
  "4": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "lora_name": "Qwen-Image-Lightning-8steps-V1.0.safetensors",
      "strength_model": 1.0,
      "model": ["1", 0]
    },
    "_meta": { "title": "Lightning 8-step LoRA (same one the photo pack uses)" }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "edit_input.png", "upload": "image" },
    "_meta": { "title": "The image to edit" }
  },
  "6": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": ["5", 0],
      "upscale_method": "nearest-exact",
      "megapixels": 1.0,
      "resolution_steps": 1
    },
    "_meta": { "title": "Normalise to ~1 megapixel — Qwen-Image-Edit expects this" }
  },
  "7": {
    "class_type": "TextEncodeQwenImageEdit",
    "inputs": {
      "clip": ["2", 0],
      "prompt": "change the bottle cap to a matte pale blue cap, keep everything else identical",
      "image": ["6", 0]
    },
    "_meta": { "title": "Edit instruction + the reference image (needs the mmproj)" }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["6", 0], "vae": ["3", 0] },
    "_meta": { "title": "Encode the source image" }
  },
  "9": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["7", 0], "latent": ["8", 0] },
    "_meta": { "title": "Bind the source latent as the edit reference" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 70707,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["9", 0],
      "negative": ["9", 0],
      "latent_image": ["8", 0]
    },
    "_meta": { "title": "positive AND negative both come from ReferenceLatent — correct at cfg 1.0" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] },
    "_meta": { "title": "Decode" }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "brand/edit", "images": ["11", 0] },
    "_meta": { "title": "Save" }
  }
}
